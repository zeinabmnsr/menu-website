{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/forms": "off",
    "axe/name-role-value": "off",
    "no-inline-styles": "off",
    "axe/aria": [
      "default",
      {
        "aria-required-parent": "off",
        "aria-valid-attr-value": "off"
      }
    ],
    "axe/parsing": [
      "default",
      {
        "duplicate-id-active": "off"
      }
    ]
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_chr <= 133",
    "not chrome <= 133",
    "not edge <= 133",
    "not firefox <= 135",
    "not safari <= 18.3",
    "not samsung <= 27"
  ]
}